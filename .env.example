# Server-only Gemini API key. Never expose this as VITE_* or commit a real value.
GEMINI_API_KEY=

# Public application URL (for links/callbacks).
APP_URL=http://localhost:3000

# Runtime configuration
PORT=3000
NODE_ENV=development

# Firebase Admin / backend auth. On Cloud Run/Firebase/Google Cloud, prefer Application Default Credentials.
# For local development set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path outside the repo.
# On hosts such as Render, paste the complete service-account JSON into FIREBASE_SERVICE_ACCOUNT_KEY.
FIREBASE_PROJECT_ID=gen-lang-client-0282286222
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-only employee PIN/session secrets. Generate separate high-entropy values; production fails closed without both.
EMPLOYEE_SESSION_SECRET=
EMPLOYEE_PIN_PEPPER=
EMPLOYEE_SESSION_TTL_MS=28800000
EMPLOYEE_LOGIN_MAX_ATTEMPTS=5
EMPLOYEE_LOGIN_LOCKOUT_MS=900000

# Demo-only local auth helpers. Keep false in production.
VITE_ENABLE_DEMO_AUTH=false
# Development-only seeded UI/auth. Keep false/unset in production.
VITE_ENABLE_DEMO_DATA=false

# Stripe Billing (server only). Create recurring Prices in Stripe and map each ShiftForce plan/cycle below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOC_2_5_MONTHLY=
STRIPE_PRICE_LOC_2_5_ANNUAL=
STRIPE_PRICE_LOC_6_10_MONTHLY=
STRIPE_PRICE_LOC_6_10_ANNUAL=
STRIPE_PRICE_LOC_11_20_MONTHLY=
STRIPE_PRICE_LOC_11_20_ANNUAL=
STRIPE_PRICE_LOC_21_50_MONTHLY=
STRIPE_PRICE_LOC_21_50_ANNUAL=
STRIPE_PRICE_LOC_51_100_MONTHLY=
STRIPE_PRICE_LOC_51_100_ANNUAL=
STRIPE_PRICE_LOC_101_200_MONTHLY=
STRIPE_PRICE_LOC_101_200_ANNUAL=
STRIPE_PRICE_LOC_201_500_MONTHLY=
STRIPE_PRICE_LOC_201_500_ANNUAL=
STRIPE_PRICE_LOC_501_1000_MONTHLY=
STRIPE_PRICE_LOC_501_1000_ANNUAL=
STRIPE_PRICE_LOC_1001_2000_MONTHLY=
STRIPE_PRICE_LOC_1001_2000_ANNUAL=

# Synthetic AI responses are disabled by default. Only enable in explicitly labeled local demos.
ENABLE_AI_DEMO_FALLBACK=false

# Supabase (database, realtime, storage)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
