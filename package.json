{
  "name": "shiftforce",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run build",
    "provision:admin": "tsx scripts/provisionAdmin.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "security:check": "node scripts/security-check.mjs",
    "provision:employee": "tsx scripts/provisionEmployee.ts",
    "pricing:check": "node scripts/enterprise-pricing-check.mjs",
    "enterprise:check": "node scripts/enterprise-85-check.mjs",
    "release:check": "node scripts/release-100-check.mjs",
    "transpile:check": "node scripts/transpile-check.mjs",
    "supabase:check": "node scripts/supabase-check.mjs",
    "supabase:bootstrap-org": "tsx scripts/bootstrapSupabaseOrg.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "stripe": "^20.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
